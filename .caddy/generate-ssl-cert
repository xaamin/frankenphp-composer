#!/bin/bash

# Install mkcert
if ! which mkcert > /dev/null 2>&1; then
    if [[ "$OSTYPE" == darwin* ]]; then
        yes | brew install mkcert nss
    else
        sudo apt install certutil libnss3-tools -y

        sudo wget -O /usr/local/bin/mkcert https://dl.filippo.io/mkcert/latest?for=linux/amd64

        sudo chmod +x /usr/local/bin/mkcert
    fi
fi

# Installl mkcert root CA
mkcert -install

# Create certs directory if it doesn't exist
mkdir -p ./.caddy/certs

# Generate the certificates within the created directory
mkcert -cert-file ./.caddy/certs/${NAME}.pem -key-file ./.caddy/certs/${NAME}-key.pem ${SERVER_NAME}
