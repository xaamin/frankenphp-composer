# frankenphp-composer settings. Add these lines to your project's .env file.

# PHP version for the dunglas/frankenphp image, e.g. 8.3, 8.4 or 8.5.
# Leave empty to use the latest PHP version shipped by FrankenPHP.
# Re-run `bash compose ...` after changing it.
PHP_VERSION=

# Docker Compose project name (groups the containers in `docker compose ls`).
# Leave empty to use the container name given with -n (lowercased; anything other than letters, digits and "-", including "_", becomes "-").
# Re-run `bash compose ...` after changing it.
COMPOSE_PROJECT_NAME=
