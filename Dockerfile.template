# Template for the Dockerfile generated by `compose`.
# Edit this file (not Dockerfile) and re-run `bash bash/compose ...`.
# {{FRANKENPHP_TAG}} becomes `1-php<PHP_VERSION>`, or `1` (latest PHP) when PHP_VERSION is empty.
FROM dunglas/frankenphp:{{FRANKENPHP_TAG}}

RUN apt update -y \
    && apt upgrade -y \
    && apt install -y procps \
    && apt-get clean \
    && apt-get -y autoremove \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN install-php-extensions \
    pdo_mysql \
    zip \
    xsl \
    bcmath \
    gmp \
    gd
