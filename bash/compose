#!/usr/bin/env bash

# Work from the project root (the parent of bash/), wherever this is run from
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

NAME=""
DATA_VOLUME="$(pwd)"
HOST_UID=$(id -u)
HOST_GID=$(id -g)
SERVER_NAME=""
SERVER_PORT=""
AUTO_TLS=""
DEPLOY_PATH=""

# Ayuda del script
function help {
  echo "Usage: $0 -n <name> [-u <uid>] [-g <gid>] [-s <server> [-a]] [-p <port>] [-d <deploy_path>] [-v]"
  exit 1
}

function verbose {
  if [ -n "$VERBOSE" ]; then
    echo "$1"
  fi
}

# Read a variable from the project's .env file (last definition wins, quotes stripped)
function env_value {
  if [ -f .env ]; then
    grep -E "^[[:space:]]*$1[[:space:]]*=" .env | tail -n 1 | cut -d= -f2- | tr -d "\"' \r"
  fi
}

# Parse params
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name)
      NAME="$2"
      shift 2
      ;;
    -u|--uid)
      HOST_UID="$2"
      shift 2
      ;;
    -g|--gid)
      HOST_GID="$2"
      shift 2
      ;;
    -s|--server)
      SERVER_NAME="$2"
      shift 2
      ;;
    -p|--port)
      SERVER_PORT="$2"
      shift 2
      ;;
    -a|--auto)
      AUTO_TLS=1
      shift
      ;;
    -d|--deploy-path)
      DEPLOY_PATH="$2"
      shift 2
      ;;
    -v|--verbose)
      VERBOSE=1
      shift
      ;;
    -h|--help)
      help
      ;;
    *)
      break
      ;;
  esac
done

# Deployer mode (-d): the whole deploy path is mounted and the app is served from
# <deploy_path>/current, so new releases go live with `bash bash/reload` without
# recreating the container. Every path in the generated docker-compose.yml must
# be the same for all releases, otherwise `docker compose up` recreates it.
if [ -n "$DEPLOY_PATH" ]; then
  if [ ! -d "$DEPLOY_PATH" ]; then
    echo "👻 Error: Deploy path not found: $DEPLOY_PATH"
    help
  fi

  DEPLOY_PATH=$(cd "$DEPLOY_PATH" && pwd -P)
  DATA_VOLUME="$DEPLOY_PATH"
  APP_ROOT="$DEPLOY_PATH/current"
  CADDY_DIR="$DEPLOY_PATH/shared/.caddy"
  BUILD_DIR="$DEPLOY_PATH/shared/.frankenphp"
else
  APP_ROOT="$DATA_VOLUME"
  CADDY_DIR=".caddy"
  BUILD_DIR="."
fi

export NAME
export DATA_VOLUME
export APP_ROOT
export FILE
export HOST_UID
export HOST_GID
export SERVER_NAME
export SERVER_PORT

# PHP version: shell environment first, then the project's .env file.
# Empty means the latest PHP version shipped by FrankenPHP.
if [ -z "$PHP_VERSION" ]; then
  PHP_VERSION=$(env_value PHP_VERSION)
fi

export PHP_VERSION="${PHP_VERSION:-}"

verbose "💡 Using PHP version ${PHP_VERSION:-latest}."

# Render the Dockerfile from its template with the FrankenPHP image for that PHP version
FRANKENPHP_TAG="1${PHP_VERSION:+-php${PHP_VERSION}}"

if [ ! -f Dockerfile.template ]; then
  echo "👻 Error: Dockerfile.template not found. Run bash/dockerize to download it."
  exit 1
fi

# Comment lines are left untouched, so the template's own docs keep the placeholder name
sed "/^[[:space:]]*#/!s|{{FRANKENPHP_TAG}}|${FRANKENPHP_TAG}|g" Dockerfile.template > Dockerfile

# Image tag = Dockerfile checksum, so unchanged Dockerfiles reuse the existing image
IMAGE_TAG="df-$(cksum < Dockerfile | cut -d' ' -f1)"
export IMAGE_TAG

if [ -n "$DEPLOY_PATH" ]; then
  # Stable build context shared by all releases
  mkdir -p "$BUILD_DIR"
  cp Dockerfile "$BUILD_DIR/Dockerfile"
fi

verbose "💡 Dockerfile generated from Dockerfile.template using dunglas/frankenphp:${FRANKENPHP_TAG}."

if [ -z "$SERVER_NAME" ] && [ -z "$SERVER_PORT" ]; then
  echo "👻 Error: Param -s/--server or -p/--port is required to configure the server. $@"
  help
fi

if [ -n "$SERVER_NAME" ] && [ -n "$SERVER_PORT" ]; then
  echo "👻 Error: Param -s/--server and -p/--port are mutually exclusive, pick just one. $@"
  help
fi

if [ -n "$AUTO_TLS" ] && [ -z "$SERVER_NAME" ]; then
  echo "👻 Error: Param -a/--auto requires -s/--server, Caddy needs a domain to issue a certificate for. $@"
  help
fi

if [ -z "$NAME" ]; then
  echo "👻 Error: Param -n/--name is required to manage the container name. $@"
  help
fi

# Docker Compose project name: shell environment first, then the project's .env file,
# then the container name normalized to lowercase letters, digits and "-".
if [ -z "$COMPOSE_PROJECT_NAME" ]; then
  COMPOSE_PROJECT_NAME=$(env_value COMPOSE_PROJECT_NAME)
fi

if [ -z "$COMPOSE_PROJECT_NAME" ]; then
  COMPOSE_PROJECT_NAME=$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9-]+/-/g; s/-+/-/g; s/^-+//; s/-+$//')

  verbose "💡 COMPOSE_PROJECT_NAME not set, using the container name as project name: ${COMPOSE_PROJECT_NAME}."
fi

export COMPOSE_PROJECT_NAME

# Create the folders Caddy mounts so they belong to the host user (Docker would create them as root on Linux)
mkdir -p "$CADDY_DIR/certs" "$CADDY_DIR/data" "$CADDY_DIR/config"

CADDY_FILE="Caddyfile"

if [[ "$OSTYPE" == darwin* ]]; then
  SED_INPLACE=(-i '')
else
  SED_INPLACE=(-i)
fi

if [ -n "$SERVER_PORT" ] || [ -n "$AUTO_TLS" ]; then
  # Comment the tls line: no TLS in port mode, Caddy-managed certificates in auto mode
  sed "${SED_INPLACE[@]}" -E 's|^([[:space:]]*)(tls[[:space:]].*)$|\1# \2|' "$CADDY_FILE"

  if [ -n "$SERVER_PORT" ]; then
    TLS_MODE="disabled (plain HTTP on port ${SERVER_PORT})"

    echo "🔓 TLS disabled: serving plain HTTP on port ${SERVER_PORT}."
  else
    if [[ "$SERVER_NAME" == "localhost" || "$SERVER_NAME" == *.localhost ]]; then
      TLS_MODE="auto (certificate issued by Caddy's local CA)"

      echo "🔒 Using auto TLS: Caddy will issue the certificate for ${SERVER_NAME} from its local CA."
      echo "   Trust ${CADDY_DIR}/data/caddy/pki/authorities/local/root.crt on this machine to avoid browser warnings (see README)."
    else
      TLS_MODE="auto (certificate issued and renewed by Caddy)"

      echo "🔒 Using auto TLS: Caddy will issue and renew the certificate for ${SERVER_NAME}."
    fi
  fi
else
  # Uncomment the tls line to serve your own certificate files
  sed "${SED_INPLACE[@]}" -E 's|^([[:space:]]*)#[[:space:]]*(tls[[:space:]].*)$|\1\2|' "$CADDY_FILE"

  TLS_MODE="custom (${CADDY_DIR}/certs/${NAME}.pem and ${NAME}-key.pem)"

  echo "🔒 Using custom TLS: ${CADDY_DIR}/certs/${NAME}.pem and ${CADDY_DIR}/certs/${NAME}-key.pem."

  if [ ! -f "${CADDY_DIR}/certs/${NAME}.pem" ] || [ ! -f "${CADDY_DIR}/certs/${NAME}-key.pem" ]; then
    echo "⚠️  Certificate files not found. Copy your certificate and private key there before starting the container."
  fi
fi

if [ -z "$SERVER_NAME" ] && [ -n "$SERVER_PORT" ]; then
  verbose "💡 Server port was provided, creating alias for server name to use the port instead."

  SERVER_NAME=":${SERVER_PORT}"
fi

COMPOSE_FILES=(-f docker-compose.template.yml)

# Docker Desktop and Rancher Desktop already resolve host.docker.internal to the
# host machine; overriding it there breaks it. Plain Docker on Linux needs it, or
# the name falls back to the host's DNS (e.g. a 127.0.0.1 entry in /etc/hosts).
ADD_HOST_GATEWAY=""
if [[ "$OSTYPE" == linux* ]]; then
  ADD_HOST_GATEWAY=1
fi

if [ -n "$SERVER_PORT" ] || [ -n "$DEPLOY_PATH" ] || [ -n "$ADD_HOST_GATEWAY" ]; then
  OVERRIDE_FILE=$(mktemp)

  trap 'rm -f "$OVERRIDE_FILE"' EXIT

  printf '%s\n' \
    'services:' \
    '  php:' > "$OVERRIDE_FILE"

  if [ -n "$ADD_HOST_GATEWAY" ]; then
    printf '%s\n' \
      '    extra_hosts:' \
      '      - "host.docker.internal:host-gateway"' >> "$OVERRIDE_FILE"
  fi

  if [ -n "$SERVER_PORT" ]; then
    printf '%s\n' \
      '    ports: !override' \
      "      - \"${SERVER_PORT}:${SERVER_PORT}\"" \
      "      - \"${SERVER_PORT}:${SERVER_PORT}/udp\"" >> "$OVERRIDE_FILE"
  fi

  if [ -n "$DEPLOY_PATH" ]; then
    # Only stable paths: the deploy path, the shared dir and the `current` symlink.
    # Caddy reads the Caddyfile of the current release; `bash bash/reload` switches it.
    printf '%s\n' \
      '    build: !override' \
      "      context: \"${BUILD_DIR}\"" \
      '      dockerfile: Dockerfile' \
      "    working_dir: \"${APP_ROOT}\"" \
      "    command: [\"frankenphp\", \"run\", \"--config\", \"${APP_ROOT}/Caddyfile\", \"--adapter\", \"caddyfile\"]" \
      '    volumes: !override' \
      "      - \"${DEPLOY_PATH}:${DEPLOY_PATH}\"" \
      "      - \"${CADDY_DIR}/data:/data\"" \
      "      - \"${CADDY_DIR}/config:/config\"" \
      "      - \"${CADDY_DIR}/certs:/etc/caddy/certs:ro\"" >> "$OVERRIDE_FILE"
  fi

  COMPOSE_FILES+=(-f "$OVERRIDE_FILE")

  verbose "💡 Docker Compose override file created at: $OVERRIDE_FILE"
fi

echo "👀 Config:"
echo "  Project name: $COMPOSE_PROJECT_NAME"
echo "  Container name: $NAME"
echo "  PHP version: ${PHP_VERSION:-latest}"
echo "  Base image: dunglas/frankenphp:${FRANKENPHP_TAG}"
echo "  Image: ${COMPOSE_PROJECT_NAME}-php:${IMAGE_TAG}"
echo "  Data volume: $DATA_VOLUME"
echo "  App root: $APP_ROOT"
if [ -n "$DEPLOY_PATH" ]; then
  echo "  Deploy mode: Deployer releases in $DEPLOY_PATH (shared state in $DEPLOY_PATH/shared)"
fi
echo "  UID: $HOST_UID"
echo "  GID: $HOST_GID"
echo "  Domain name: $SERVER_NAME"
echo "  Server port: ${SERVER_PORT:-80,443}"
echo "  TLS: $TLS_MODE"

docker compose "${COMPOSE_FILES[@]}" config > docker-compose.yml

echo ""
if [ -n "$DEPLOY_PATH" ]; then
  echo "🌐 Switch the running container to this release with: bash bash/reload"
  echo "   Then, after deploy:symlink: docker compose up -d (starts it the first time, rebuilds only if the Dockerfile changed)"
else
  echo "🌐 To start the container, run: docker compose up -d (it builds the image when the Dockerfile changes)"
fi